{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "livim",
  "version": "1.0.0",
  "description": "Live video motion and color magnification.",
  "builtin-baseline": "a5ac4c37640e9cd2b1662e5b0c33886ea2dda9bf",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale"
      ]
    },
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "ffmpeg"
      ]
    },
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "msmf",
        "dshow"
      ],
      "platform": "windows"
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets",
        "opengl",
        "png"
      ]
    },
    {
      "name": "qtbase",
      "host": true,
      "default-features": false,
      "features": [
        "gui",
        "widgets"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "xcb",
        "xcb-xlib",
        "xcb-sm",
        "xrender",
        "egl",
        "fontconfig",
        "freetype",
        "harfbuzz",
        "dbus"
      ],
      "platform": "linux"
    },
    {
      "name": "qtwayland",
      "platform": "linux"
    }
  ]
}