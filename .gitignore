# Build intermediates
/build/

# Shippable artifacts (CPack packages + AppImage all land here)
/dist/

# Generated compile database (machine-specific absolute paths)
compile_commands.json

# vcpkg manifest-mode installed tree
/vcpkg_installed/

# Machine-specific CMake preset overrides (e.g. CMAKE_MAKE_PROGRAM for Ninja)
CMakeUserPresets.json

# IDE / editor
/.vs/
/.vscode/
*.user

# AppImage packaging: downloaded linuxdeploy/appimagetool cache
/packaging/.tools/